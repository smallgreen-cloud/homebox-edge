{
  "name": "homebox-edge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "test": "vitest run --coverage",
    "test:red": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "dev": "wrangler dev --local",
    "migrate:local": "wrangler d1 migrations apply homebox-edge --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.115.0"
  }
}
